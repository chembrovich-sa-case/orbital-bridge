# ========================================================
# ORBITAL BRIDGE CONFIGURATION
# ========================================================

# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Your Telegram User ID (get it from @userinfobot or @getmyid_bot)
# Multiple IDs can be separated by commas: 12345678,87654321
ALLOWED_USER_IDS=your_telegram_user_id_here

# Google Gemini API Key (optional, for /chat and AI agent)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Directory where /new_project will create folders
# Defaults to the parent folder of the project if left blank
PROJECTS_DIR=

# Watchdog settings
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL=60
BATTERY_ALERT_THRESHOLD=20
